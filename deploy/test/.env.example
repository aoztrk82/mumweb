# Copy to deploy/test/.env (git-ignored) and fill in. Avoid '$' and quotes in values.

# Domain for the test site; its DNS A/AAAA record must point to this server (Caddy gets a certificate for it).
MUMWEB_DOMAIN=test.example.com
MUMBLE_SUPERUSER_PASSWORD=change-me-long-random
# Web access password (door code) and admin panel password: set both, use long random values and share
# them with whoever runs the tests.
MUMWEB_ACCESS_PASSWORD=change-me-access
MUMWEB_ADMIN_PASSWORD=change-me-admin-long-random
# Reserved slots: with 200 web slots, keep 5 for people who enter this password (empty = feature off).
MUMWEB_RESERVED_SLOTS=5
MUMWEB_RESERVED_PASSWORD=change-me-reserved
# Optional: lets the admin panel mint invite links that skip the access password (empty = feature off).
# MUMWEB_INVITE_SECRET=change-me-invite-long-random

# Image: "latest" follows the newest release. Reserved slots need 0.3.1 or newer; pin once the test starts.
# MUMWEB_VERSION=0.3.1
# Limits (defaults are the loose test values in compose.yaml)
# MUMWEB_MAX_SESSIONS=200
# MUMWEB_MAX_SESSIONS_PER_IP=100
# MUMWEB_CONN_RATE=600
# MUMWEB_LOG_LEVEL=debug
# MUMBLE_MAX_USERS=200
