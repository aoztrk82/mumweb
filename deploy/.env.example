# Copy to deploy/.env (git-ignored) and fill in.

# --- production (docker-compose.yml) ---
# Public domain; its DNS A/AAAA record must point to this server before starting.
MUMWEB_DOMAIN=ses.example.com
# SuperUser password for the Mumble server (also used by the dev compose).
MUMBLE_SUPERUSER_PASSWORD=change-me
# Optional:
# All three images are pinned by digest in docker-compose.yml (default values below), so `docker compose pull`
# never changes what is running until you deliberately update these. To take a newer mumweb release, copy its
# "image:" line from https://hub.docker.com/r/aoztrk82/mumweb/tags (or run `make publish`, which prints it) into
# MUMWEB_IMAGE below; same idea for MUMBLE_IMAGE (https://hub.docker.com/r/mumblevoip/mumble-server/tags) and
# CADDY_IMAGE (https://hub.docker.com/_/caddy/tags). Un-pinned ("latest"/"2", no @sha256) also works, you just lose
# the guarantee that an update is not a surprise.
# MUMWEB_IMAGE=aoztrk82/mumweb:0.3.1@sha256:0e627df0611c6904a30f2d721ed166b566f7f6dda471b54165614443c6a56a3c
# MUMBLE_IMAGE=mumblevoip/mumble-server:latest@sha256:018ad3515932e513d8fdc970df918373a2664c4da32b09a89a4aaee28eb7507a
# CADDY_IMAGE=caddy:2@sha256:685ae3d7c34d9b5f8caeddc5d14051db7bbd88ff1f5a2fa0c16bd8ca328fb7af
# MUMBLE_WELCOME_TEXT=Welcome to our Mumble server!
# MUMBLE_MAX_USERS=50
# Web users the gateway accepts at once (independent of MUMBLE_MAX_USERS). Example: 10 web slots on a 50 slot server.
# MUMWEB_MAX_SESSIONS=50
# Keep N of those slots for people who enter MUMWEB_RESERVED_PASSWORD on the login screen (both needed, else off).
# MUMWEB_RESERVED_SLOTS=2
# MUMWEB_RESERVED_PASSWORD=
# MUMWEB_LOG_LEVEL=info
# Allow logging in as SuperUser from the web client (default false).
# MUMWEB_ALLOW_SUPERUSER=false
# Require a password to use the web client (empty = open). Desktop Mumble clients are not affected;
# they use the Mumble server password. Avoid '$' and quotes in the value.
# MUMWEB_ACCESS_PASSWORD=
# Switch on the admin panel at /admin (empty = off). Use a long random value and HTTPS only.
# MUMWEB_ADMIN_PASSWORD=

# --- development (docker-compose.dev.yml) ---
# Host port for the dev Mumble server (tcp+udp). Change if 64738 is taken.
MUMBLE_PORT=64738
