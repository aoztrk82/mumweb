# Copy to deploy/.env (git-ignored) and fill in.

# Public domain the gateway will be served on (used by production deploy, later phases).
MUMWEB_DOMAIN=mumweb.example.com

# SuperUser password for the Mumble server (dev compose).
MUMBLE_SUPERUSER_PASSWORD=change-me

# Host port for the dev Mumble server (tcp+udp). Change if 64738 is taken.
MUMBLE_PORT=64738
