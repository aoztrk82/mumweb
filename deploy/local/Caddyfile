{
	# The certificate comes from mkcert (./certs); never contact a public CA.
	auto_https disable_certs
}

{$MUMWEB_DOMAIN} {
	tls /certs/cert.pem /certs/key.pem
	encode zstd gzip
	header {
		# Browsers keep using HTTPS for a year after the first visit.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy mumweb:8080
}
