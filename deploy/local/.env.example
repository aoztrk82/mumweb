# Optional overrides for the local environment. Copy to .env (git-ignored) if needed.
# Without a .env file the defaults below are used.

# Domain you put in the hosts file and in the mkcert certificate.
MUMWEB_DOMAIN=mumweb.test

# Host ports. Change if they are taken (e.g. IIS or another proxy on 80/443).
# With a non-default HTTPS port open https://mumweb.test:<port>.
HTTPS_PORT=443
HTTP_PORT=80
MUMBLE_PORT=64738

# SuperUser password (log in as "SuperUser" in the desktop client to create channels).
MUMBLE_SUPERUSER_PASSWORD=superuser

MUMWEB_LOG_LEVEL=debug
