# Optional overrides for the local environment. Copy to .env (git-ignored) if needed.
# Without a .env file the defaults below are used.

# Domain you put in the hosts file and in the mkcert certificate.
MUMWEB_DOMAIN=mumweb.test

# Host ports. Change if they are taken (e.g. IIS or another proxy on 80/443).
# With a non-default HTTPS port open https://mumweb.test:<port>.
HTTPS_PORT=443
HTTP_PORT=80
MUMBLE_PORT=64738

# SuperUser password: log in as "SuperUser" (desktop client, or the web login with this
# value in the server password field) to create channels and manage the server.
MUMBLE_SUPERUSER_PASSWORD=superuser
# Allow the SuperUser login from the web client (production default: false).
MUMWEB_ALLOW_SUPERUSER=true

# Require a password to use the web client (empty = open).
MUMWEB_ACCESS_PASSWORD=

# Admin panel at /admin (empty = off). Log in there as SuperUser with MUMBLE_SUPERUSER_PASSWORD.
MUMWEB_ADMIN_PASSWORD=admin

MUMWEB_LOG_LEVEL=debug
